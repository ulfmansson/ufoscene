[Unit]
Description=ufoscene on the TV (native player on tty1, no browser)
After=systemd-user-sessions.service ufoscene-server.service user@@KUID@.service
Wants=ufoscene-server.service
# the TV has room for one of the two: starting either one stops the other
Conflicts=getty@tty1.service ufoscene-kiosk.service

[Service]
User=@USER@
# a login session on tty1, as the kiosk has: it makes the player DRM master of the screen
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# PipeWire (parec, mpv) of the kiosk user
Environment=XDG_RUNTIME_DIR=/run/user/@KUID@
# /var/lib/ufoscene-native: the audio source, radio station and TV mode across restarts
StateDirectory=ufoscene-native
WorkingDirectory=/home/@USER@
# the demos take whatever CPU is left; music (PipeWire, AirPlay, Bluetooth) comes first
Nice=5
ExecStart=@BIN@
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
